# Copy to backend/.env and fill in. Never commit the real .env.
# Neon: Dashboard -> Connect -> copy the connection string (keep sslmode/channel_binding).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Optional: public base URL of object storage / CDN holding the glasses images.
# Leave empty to serve the bundled demo images from this API's /static path.
ASSET_BASE_URL=

# Optional: comma-separated CORS origins (mobile apps don't need CORS).
CORS_ORIGINS=*
